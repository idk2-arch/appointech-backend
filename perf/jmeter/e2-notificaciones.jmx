<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="AppoinTech E2 - Notificaciones">
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Variables">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="E2 - Clientes">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${__P(loops,10)}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(usuarios,30)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampa,15)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="JSON y token de la identidad">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Accept</stringProp>
              <stringProp name="Header.value">application/json</stringProp>
            </elementProp>
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Authorization</stringProp>
              <stringProp name="Header.value">Bearer ${e2Token}</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="E2 GET /api/notificaciones">
          <stringProp name="HTTPSampler.protocol">${__P(protocolo,http)}</stringProp>
          <stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(puerto,18080)}</stringProp>
          <stringProp name="HTTPSampler.path">/api/notificaciones?page=0&amp;size=20</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <stringProp name="HTTPSampler.connect_timeout">${__P(timeoutConexionMs,5000)}</stringProp>
          <stringProp name="HTTPSampler.response_timeout">${__P(timeoutRespuestaMs,10000)}</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Asignar una identidad estable por hilo">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"/>
            <stringProp name="script"><![CDATA[
import com.fasterxml.jackson.databind.ObjectMapper

if (vars.getObject('e2Identidad') == null) {
    def prefijo = props.getProperty('identidadesEnv')
    def preparado = System.getenv(prefijo + (ctx.getThreadNum() + 1))
    if (!preparado) {
        ctx.getEngine().stopTest(true)
        throw new IllegalStateException('Identidad E2 ausente. Ejecute mediante ejecutar-e2.ps1.')
    }
    def mapper = new ObjectMapper()
        .enable(com.fasterxml.jackson.databind.DeserializationFeature.FAIL_ON_TRAILING_TOKENS)
    def identidad
    try {
        identidad = mapper.readTree(preparado)
    } catch (IOException ignored) {
        ctx.getEngine().stopTest(true)
        throw new IllegalStateException('Paquete de identidad E2 invalido')
    }
    vars.putObject('e2Mapper', mapper)
    vars.putObject('e2Identidad', identidad)
    vars.put('e2Token', identidad.path('token').textValue())
}
]]></stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Conservar diagnostico de transporte y censurar autenticacion">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"/>
            <stringProp name="script"><![CDATA[
def codigo = prev.getResponseCode() ?: ''
if (codigo ==~ /[0-9]{3}/) {
    prev.setResponseMessage('HTTP ' + codigo)
} else {
    def token = vars.get('e2Token')
    def limpiar = { String valor ->
        if (token) valor = valor.replace(token, '[REDACTADO]')
        valor.replaceAll(/(?i)Bearer\s+[^\s,;]+/, 'Bearer [REDACTADO]')
             .replaceAll(/eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+/, '[REDACTADO]')
    }
    prev.setResponseCode(limpiar(codigo))
    prev.setResponseMessage(limpiar(prev.getResponseMessage() ?: ''))
}
]]></stringProp>
          </JSR223PostProcessor>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="HTTP y transporte">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"/>
            <stringProp name="script"><![CDATA[
def codigo = prev.getResponseCode() ?: ''
if (codigo != '200') {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(codigo ==~ /[0-9]{3}/ ?
        'HTTP - se esperaba 200' : 'Transporte - consultar codigo y mensaje de respuesta')
}
]]></stringProp>
          </JSR223Assertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Contenido, paginacion e identidad">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"/>
            <stringProp name="script"><![CDATA[
import java.time.LocalDateTime

if (prev.getResponseCode() != '200') return
def fallo = { String motivo ->
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('Contenido - ' + motivo)
}
def identidad = vars.getObject('e2Identidad')
def esperado = identidad.path('notificaciones')
def totales = prev.getResponseHeaders().readLines().findAll { it ==~ /(?i)X-Total-Count:.*/ }
if (totales.size() != 1 || totales[0].split(':', 2)[1].trim() != identidad.path('total').asText()) {
    fallo('X-Total-Count incorrecto')
    return
}
def filas
try {
    filas = vars.getObject('e2Mapper').readTree(prev.getResponseData())
} catch (IOException ignored) {
    fallo('JSON invalido')
    return
}
if (!filas?.isArray() || filas.size() != esperado.size()) {
    fallo('se esperaba un arreglo de tres notificaciones')
    return
}
def idValido = { nodo -> nodo.isIntegralNumber() && nodo.canConvertToLong() && nodo.longValue() > 0 }
def tipos = identidad.path('tipos').collect { it.asText() }
def ids = new HashSet<Long>()
int sinLeer = 0
for (int i = 0; i < filas.size(); i++) {
    def f = filas.get(i)
    def e = esperado.get(i)
    def id = f.path('id')
    def cita = f.path('citaId')
    if (!f.isObject() || !idValido(id) || !ids.add(id.longValue()) ||
        !f.path('tipo').isTextual() || !tipos.contains(f.path('tipo').textValue()) ||
        !f.path('titulo').isTextual() || !f.path('mensaje').isTextual() ||
        !f.path('leida').isBoolean() || !(cita.isNull() || idValido(cita)) ||
        !f.path('creadaEn').isTextual()) {
        fallo('tipos de campos o identificadores invalidos')
        return
    }
    try {
        if (LocalDateTime.parse(f.path('creadaEn').textValue()) != LocalDateTime.parse(e.path('creadaEn').textValue())) {
            fallo('creadaEn difiere de la expectativa')
            return
        }
    } catch (java.time.format.DateTimeParseException ignored) {
        fallo('creadaEn no es una fecha y hora local ISO valida')
        return
    }
    if (id.longValue() != e.path('id').longValue()) {
        fallo('IDs u orden distintos de los esperados para la identidad')
        return
    }
    if (['tipo', 'titulo', 'mensaje', 'leida', 'citaId'].any { f.path(it) != e.path(it) }) {
        fallo('campos distintos de los esperados para la identidad')
        return
    }
    if (!f.path('leida').booleanValue()) sinLeer++
}
if (sinLeer != identidad.path('sinLeer').intValue()) fallo('cantidad de no leidas incorrecta')
]]></stringProp>
          </JSR223Assertion>
          <hashTree/>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duracion - umbral de notificaciones">
            <stringProp name="DurationAssertion.duration">${__P(umbralLecturaMs,800)}</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
