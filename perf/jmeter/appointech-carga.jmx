<JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="token admin" enabled="true">
<stringProp name="JSONPostProcessor.referenceNames">adminToken</stringProp>
<stringProp name="JSONPostProcessor.jsonPathExprs">$.datos.token</stringProp>
<stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
<stringProp name="JSONPostProcessor.defaultValues">NO_TOKEN</stringProp>
</JSONPostProcessor>
<hashTree>

</hashTree>
<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Publicar el token como propiedad JMeter" enabled="true">
<stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">def token = vars.get('adminToken'); if (!token || token == 'NO_TOKEN') { prev.setSuccessful(false); ctx.getEngine().stopTest(); } else { props.put('adminToken', token); }</stringProp>
</JSR223PostProcessor>
<hashTree>

</hashTree>
</hashTree>
