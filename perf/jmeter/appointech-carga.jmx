<stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">if (vars.get('token') == null) { def t = vars.get('tokenCsv'); if (!t || t == 'NO_TOKEN') throw new IllegalStateException('Token de preparacion ausente'); vars.put('token', t); }</stringProp>
