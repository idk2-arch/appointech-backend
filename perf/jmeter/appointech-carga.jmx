<stringProp name="ThreadGroup.num_threads">${__groovy((int)((${__P(usuarios,50)}*1) - Math.ceil((${__P(usuarios,50)}*1)*2/100.0) - Math.ceil((${__P(usuarios,50)}*1)*25/100.0) - Math.ceil((${__P(usuarios,50)}*1)*10/100.0) - Math.ceil((${__P(usuarios,50)}*1)*20/100.0) - Math.ceil((${__P(usuarios,50)}*1)*20/100.0)))}</stringProp><stringProp name="ThreadGroup.ramp_time">${__P(rampa,30)}</stringProp><boolProp name="ThreadGroup.scheduler">true</boolProp><stringProp name="ThreadGroup.duration">${__P(duracion,120)}</stringProp><stringProp name="ThreadGroup.delay">0</stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
