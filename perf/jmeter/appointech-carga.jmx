<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Guardar exclusivamente token sintetico en CSV" enabled="true">
<stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">def t = vars.get('tokenPreparado'); if (!t || t == 'NO_TOKEN' || prev.getResponseCode() != '200') { prev.setSuccessful(false); ctx.getEngine().stopTest(); } else { java.nio.file.Files.writeString(java.nio.file.Paths.get(props.getProperty('tokens_csv', 'perf/jmeter/tokens.csv')), t + System.lineSeparator(), java.nio.file.StandardOpenOption.APPEND); }</stringProp>
</JSR223PostProcessor>
<hashTree>

</hashTree>
</hashTree>
</hashTree>
<JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="setUp|inicio medicion" enabled="true">
<stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"/><stringProp name="filename"/><stringProp name="cacheKey">true</stringProp><stringProp name="script">props.put('medicionPreparada', 'true')</stringProp></JSR223Sampler>
<hashTree>

</hashTree>
