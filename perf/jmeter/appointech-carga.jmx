<JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="token preparado" enabled="true">
<stringProp name="JSONPostProcessor.referenceNames">tokenPreparado</stringProp>
<stringProp name="JSONPostProcessor.jsonPathExprs">$.datos.token</stringProp>
<stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
<stringProp name="JSONPostProcessor.defaultValues">NO_TOKEN</stringProp>
</JSONPostProcessor>
