# Copia este archivo a .env y reemplaza los valores. NO subas el .env real al repositorio.

# Base de datos
DB_NAME=appointech
DB_USER=appointech
DB_PASSWORD=cambia-esta-contrasena

# Seguridad
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Puertos publicados
PUERTO_EXTERNO_API=8080

# Opcionales (tienen valor por defecto; sin valor real aqui)
ORS_API_KEY=
# Pre-diagnostico con IA (Groq): sin clave el endpoint responde "no disponible"
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=6000
RUTA_TOLERANCIA_MINUTOS=5
# Telefono de WhatsApp del administrador de respaldo (solo si no hay uno guardado en la configuracion de cobertura)
CONTACTO_ADMIN_TELEFONO=

# Correo SMTP del microservicio de notificaciones (valores de ejemplo; usa los de tu proveedor)
# Con Gmail: genera una "contrasena de aplicacion"; no uses la contrasena de la cuenta.
MAIL_HOST=smtp.ejemplo.com
MAIL_PORT=587
MAIL_USER=usuario@ejemplo.com
MAIL_PASSWORD=cambia-esta-contrasena-de-correo
MAIL_FROM=no-responder@ejemplo.com

# Almacenamiento de objetos S3 para las fotos de perfil (MinIO en docker-compose). Valores de ejemplo: cambialos.
# MinIO exige una clave secreta de 8 caracteres o mas. Con otro proveedor S3 cambia endpoint, claves y region.
ALMACENAMIENTO_ENDPOINT=http://almacenamiento:9000
ALMACENAMIENTO_ACCESS_KEY=cambia-este-usuario-de-almacenamiento
ALMACENAMIENTO_SECRET_KEY=cambia-esta-clave-de-almacenamiento
ALMACENAMIENTO_BUCKET=fotos-perfil
ALMACENAMIENTO_REGION=us-east-1

# Pagos: sin PASARELA_PAGOS el codigo usa "wompi" (pago en linea no disponible). "simulada" (sin llamadas externas) es SOLO para desarrollo; con ella, PASARELA_SIMULADA_APROBAR fija el resultado
PASARELA_PAGOS=simulada
PASARELA_SIMULADA_APROBAR=true
# Diferencia (%) entre el monto cotizado y el costo final a partir de la cual se marca como significativa
PAGOS_UMBRAL_DIFERENCIA_PORCENTAJE=20
# Pagina del frontend a la que la pasarela devuelve al cliente despues de pagar
PAGOS_URL_RETORNO=http://localhost:4200/cliente/pago/resultado
